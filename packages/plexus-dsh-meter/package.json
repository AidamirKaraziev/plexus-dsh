{
  "name": "@plexus-dsh/meter",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AidamirKaraziev/plexus-dsh.git",
    "directory": "packages/plexus-dsh-meter"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "description": "После каждого хода — $ и % окна за 5 ч по всем сессиям DSH в журнал учёта.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "src/**/*.ts",
    "locale/*.json",
    "README.md"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "plexus": {
    "id": "plexus-dsh-meter",
    "config": {
      "windowHours": 5,
      "budgetUsd": 12
    },
    "bundle": {
      "build": true
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b && node --test \"test/*.test.mjs\""
  }
}

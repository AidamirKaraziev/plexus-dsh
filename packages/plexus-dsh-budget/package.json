{
  "name": "@plexus-dsh/budget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "description": "Предупреждает модель при подходе к бюджету и останавливает ход при его исчерпании, переполненном окне или шагах без прогресса.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "src/**/*.ts",
    "locale/*.json",
    "README.md"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "plexus": {
    "id": "plexus-dsh-budget",
    "config": {
      "profile": "{profile}",
      "budgetUsd": 1,
      "windowPct": 90,
      "noProgressSteps": 8
    },
    "bundle": {
      "build": false
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b && node --test lib/budget.test.js lib/usage.test.js"
  }
}

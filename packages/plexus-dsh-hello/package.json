{
  "name": "@plexus-dsh/hello",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "description": "На конец хода пишет событие в журнал сессии DSH — дым, что плагин загружен и слышит хуки.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "src/**/*.ts",
    "locale/*.json",
    "README.md"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "plexus": {
    "id": "plexus-dsh-hello",
    "config": {
      "label": "{profile}"
    },
    "bundle": {
      "build": false
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b && node --test \"test/*.test.mjs\""
  }
}

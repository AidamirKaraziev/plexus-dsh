{
  "name": "plexus-dsh-packages",
  "private": true,
  "type": "module",
  "description": "Пакеты Plexus DSH — плагины Cordis для DeepSeek Harness",
  "scripts": {
    "build": "node ../tools/brandinfo.mjs && tsc -b plexus-dsh-*/tsconfig.json && node ../tools/brandinfo.mjs --копии && node ../tools/copy-prices.mjs",
    "prepare": "node ../tools/brandinfo.mjs && tsc -b plexus-dsh-*/tsconfig.json && node ../tools/brandinfo.mjs --копии && node ../tools/copy-prices.mjs",
    "clean": "tsc -b --clean plexus-dsh-*/tsconfig.json",
    "test": "pnpm run -r test",
    "dsh:install": "../tools/install.sh",
    "dsh:uninstall": "../tools/install.sh --uninstall"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cosmokit": "~1.9.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "~24.0.15",
    "typescript": "~5.9.0"
  }
}
